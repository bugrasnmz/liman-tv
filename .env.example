# ── Xtream hesabın ─────────────────────────────────────────────
# Sunucu adresi (port dahil). Örn: http://ornek-sunucu.com:8080
XTREAM_URL=http://ornek-sunucu.com:8080
XTREAM_USERNAME=kullanici_adin
XTREAM_PASSWORD=sifren

# İpucu: Elinde sadece M3U linki varsa (get.php?username=...&password=...)
# onu doğrudan XTREAM_URL'e yapıştırabilirsin; kullanıcı adı/şifre otomatik ayrılır.

# ── Web arayüzü ────────────────────────────────────────────────
# Sayfayı açan herkesin hesabını kullanmaması için bir giriş şifresi.
# Boş bırakırsan giriş ekranı kapanır (sadece yerel ağda önerilir).
APP_PASSWORD=buraya-guclu-bir-sifre

PORT=8080
HOST=0.0.0.0

# İsteğe bağlı ayarlar
# SESSION_SECRET=uzun-rastgele-bir-metin
# CACHE_TTL_MINUTES=10
# Bazı sağlayıcılar tanımadığı istemcileri reddeder; gerekirse değiştir.
# USER_AGENT=VLC/3.0.20 LibVLC/3.0.20
